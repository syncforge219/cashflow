# ==========================================
# CoachFlow / CashFlow Environment Variables Example
# ==========================================

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/cashflow

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
# Required by Vercel crons (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=generate_a_long_random_string

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Meta / Facebook Lead Ads Connector (OAuth Divert)
FACEBOOK_APP_ID=your_meta_app_id_here
FACEBOOK_APP_SECRET=your_meta_app_secret_here

# Google Gemini AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Google reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# MSG91 WhatsApp & SMS Configuration
MSG91_AUTHKEY=your_msg91_authkey
MSG91_INTEGRATED_NUMBER=your_msg91_sender_number
MSG91_DEFAULT_PDF_HOST=

# Admin Contacts
ADMIN_WHATSAPP_NUMBER=
ADMIN_PHONE=
SUPER_ADMIN_PHONE=
ADMIN_EMAIL=

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
